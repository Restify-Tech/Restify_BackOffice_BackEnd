    // ========== EMPLOYEE REPORTS ==========

    /// <summary>
    /// GET /api/backoffice/reports/employees/performance?from=...&to=...
    /// </summary>
    [HttpGet("employees/performance")]
    public async Task<ActionResult<Result<List<EmployeePerformanceDto>>>> GetEmployeePerformance(
        [FromQuery] DateTime from,
        [FromQuery] DateTime to,
        CancellationToken cancellationToken)
    {
        try
        {
            var tenantId = _currentUserService.TenantId;
            var result = await _reportService.GetEmployeePerformanceAsync(from, to, tenantId, cancellationToken);
            return Ok(Result<List<EmployeePerformanceDto>>.Success(result));
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error getting employee performance");
            return BadRequest(Result<List<EmployeePerformanceDto>>.Failure("Error al obtener rendimiento de empleados"));
        }
    }

    /// <summary>
    /// GET /api/backoffice/reports/employees/top-performer?from=...&to=...
    /// </summary>
    [HttpGet("employees/top-performer")]
    public async Task<ActionResult<Result<TopPerformerDto>>> GetTopPerformer(
        [FromQuery] DateTime from,
        [FromQuery] DateTime to,
        CancellationToken cancellationToken)
    {
        try
        {
            var tenantId = _currentUserService.TenantId;
            var result = await _reportService.GetTopPerformerAsync(from, to, tenantId, cancellationToken);
            
            if (result == null)
                return Ok(Result<TopPerformerDto>.Failure("No hay datos de rendimiento en el período seleccionado"));
            
            return Ok(Result<TopPerformerDto>.Success(result));
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error getting top performer");
            return BadRequest(Result<TopPerformerDto>.Failure("Error al obtener mejor empleado"));
        }
    }

    /// <summary>
    /// GET /api/backoffice/reports/employees/errors?from=...&to=...

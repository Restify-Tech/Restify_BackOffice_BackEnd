        catch (Exception ex)
        {
            _logger.LogError(ex, "Error getting peak hours");
            return BadRequest(Result<List<PeakHoursDto>>.Failure("Error al obtener horas pico"));
        }
    }

    // ========== PRODUCT REPORTS ==========

    /// <summary>
    /// GET /api/backoffice/reports/products/top-selling?from=...&to=...&limit=10
    /// </summary>
    [HttpGet("products/top-selling")]
    public async Task<ActionResult<Result<List<TopSellingProductDto>>>> GetTopSellingProducts(
        [FromQuery] DateTime from,
        [FromQuery] DateTime to,
        [FromQuery] int limit = 10,
        CancellationToken cancellationToken = default)
    {
        try
        {
            var tenantId = _currentUserService.TenantId;
            var result = await _reportService.GetTopSellingProductsAsync(from, to, limit, tenantId, cancellationToken);
            return Ok(Result<List<TopSellingProductDto>>.Success(result));

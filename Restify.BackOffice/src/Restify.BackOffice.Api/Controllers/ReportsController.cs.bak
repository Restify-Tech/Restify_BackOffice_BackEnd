        CancellationToken cancellationToken)
    {
        try
        {
            var tenantId = _currentUserService.TenantId;
            var result = await _reportService.GetPeakHoursAsync(from, to, tenantId, cancellationToken);
            return Ok(Result<List<PeakHoursDto>>.Success(result));

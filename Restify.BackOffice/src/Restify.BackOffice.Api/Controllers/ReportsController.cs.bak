        {
            var tenantId = _currentUserService.TenantId;
            var result = await _reportService.GetSalesByTimeSlotAsync(from, to, tenantId, cancellationToken);
            return Ok(Result<List<SalesByTimeSlotDto>>.Success(result));
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error getting sales by timeslot");
            return BadRequest(Result<List<SalesByTimeSlotDto>>.Failure("Error al obtener ventas por franja horaria"));
        }
    }

    /// <summary>
    /// GET /api/backoffice/reports/sales/peak-hours?from=...&to=...

using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using Restaurant.BackOffice.Application.DTOs.Reports;
using Restaurant.BackOffice.Application.Interfaces;
using Restaurant.BackOffice.Domain.Enums;
using Restaurant.Core.Application.DTOs.Common;
using Restaurant.Core.Application.Interfaces;

namespace Restaurant.BackOffice.Api.Controllers;

[ApiController]
[Route("api/backoffice/[controller]")]
[Authorize]
public class ReportsController : ControllerBase
{
    private readonly IReportService _reportService;
    private readonly ICurrentUserService _currentUserService;
    private readonly ILogger<ReportsController> _logger;

    public ReportsController(
        IReportService reportService,
        ICurrentUserService currentUserService,
        ILogger<ReportsController> logger)
    {
        _reportService = reportService;
        _currentUserService = currentUserService;
        _logger = logger;
    }

    // ========== SALES REPORTS ==========

    /// <summary>
    /// GET /api/backoffice/reports/sales/summary?from=2026-01-01&to=2026-01-31
    /// </summary>
    [HttpGet("sales/summary")]
    public async Task<ActionResult<Result<SalesSummaryDto>>> GetSalesSummary(
        [FromQuery] DateTime from,
        [FromQuery] DateTime to,
        CancellationToken cancellationToken)
    {
        try
        {
            var tenantId = _currentUserService.TenantId;
            var result = await _reportService.GetSalesSummaryAsync(from, to, tenantId, cancellationToken);
            return Ok(Result<SalesSummaryDto>.Success(result));
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error getting sales summary");
            return BadRequest(Result<SalesSummaryDto>.Failure("Error al obtener resumen de ventas"));
        }
    }

    /// <summary>
    /// GET /api/backoffice/reports/sales/comparative?periodType=Today
    /// </summary>
    [HttpGet("sales/comparative")]
    public async Task<ActionResult<Result<ComparativeSalesReportDto>>> GetComparativeSales(
        [FromQuery] PeriodType periodType,
        CancellationToken cancellationToken)
    {
        try
        {
            var tenantId = _currentUserService.TenantId;
            var result = await _reportService.GetComparativeSalesAsync(periodType, tenantId, cancellationToken);
            return Ok(Result<ComparativeSalesReportDto>.Success(result));
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error getting comparative sales");
            return BadRequest(Result<ComparativeSalesReportDto>.Failure("Error al obtener comparativa de ventas"));
        }
    }

    /// <summary>
    /// GET /api/backoffice/reports/sales/by-payment-method?from=...&to=...
    /// </summary>
    [HttpGet("sales/by-payment-method")]
    public async Task<ActionResult<Result<List<SalesByPaymentMethodDto>>>> GetSalesByPaymentMethod(
        [FromQuery] DateTime from,
        [FromQuery] DateTime to,
        CancellationToken cancellationToken)
    {
        try
        {
            var tenantId = _currentUserService.TenantId;
            var result = await _reportService.GetSalesByPaymentMethodAsync(from, to, tenantId, cancellationToken);
            return Ok(Result<List<SalesByPaymentMethodDto>>.Success(result));
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error getting sales by payment method");
            return BadRequest(Result<List<SalesByPaymentMethodDto>>.Failure("Error al obtener ventas por método de pago"));
        }
    }

    /// <summary>
    /// GET /api/backoffice/reports/sales/by-timeslot?from=...&to=...

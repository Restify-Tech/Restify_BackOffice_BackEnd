{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Yarp": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "Restify.Auth",
    "Audience": "Restify.Client"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000", "http://localhost:3002", "http://localhost:3100", "http://localhost:8081"]
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "auth-users-route": {
        "ClusterId": "auth",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "auth-roles-route": {
        "ClusterId": "auth",
        "Match": { "Path": "/api/roles/{**catch-all}" }
      },
      "auth-tenants-route": {
        "ClusterId": "auth",
        "Match": { "Path": "/api/tenants/{**catch-all}" }
      },
      "auth-screenpermissions-route": {
        "ClusterId": "auth",
        "Match": { "Path": "/api/screenpermissions/{**catch-all}" }
      },
      "auth-tenant-onboarding-route": {
        "ClusterId": "auth",
        "Match": { "Path": "/api/tenant/onboarding/{**catch-all}" }
      },
      "auth-general-values-route": {
        "ClusterId": "auth",
        "Match": { "Path": "/api/general-values/{**catch-all}" }
      },
      "auth-customerauth-route": {
        "ClusterId": "auth",
        "Match": { "Path": "/api/customerauth/{**catch-all}" }
      },
      "auth-pool-drivers-route": {
        "ClusterId": "auth",
        "Match": { "Path": "/api/pool-drivers/{**catch-all}" }
      },
      "auth-deliveryzones-route": {
        "ClusterId": "auth",
        "Match": { "Path": "/api/deliveryzones/{**catch-all}" }
      },
      "auth-plans-route": {
        "ClusterId": "auth",
        "Match": { "Path": "/api/plans/{**catch-all}" }
      },
      "auth-driverauth-route": {
        "ClusterId": "auth",
        "Match": { "Path": "/api/driverauth/{**catch-all}" }
      },
      "core-gridconfigurations-route": {
        "ClusterId": "core",
        "Match": { "Path": "/api/gridconfigurations/{**catch-all}" }
      },
      "core-generaltables-route": {
        "ClusterId": "core",
        "Match": { "Path": "/api/generaltables/{**catch-all}" }
      },
      "core-generalvalues-route": {
        "ClusterId": "core",
        "Match": { "Path": "/api/generalvalues/{**catch-all}" }
      },
      "core-dataprovider-route": {
        "ClusterId": "core",
        "Match": { "Path": "/api/dataprovider/{**catch-all}" }

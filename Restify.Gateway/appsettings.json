      "backoffice-cashregisters-route": {
        "ClusterId": "backoffice",
        "Match": { "Path": "/api/backoffice/cashregisters/{**catch-all}" }
      },
      "backoffice-customer-menu-route": {
        "ClusterId": "backoffice",
        "Match": { "Path": "/api/customer/{**catch-all}" }
      },
      "backoffice-transfer-approvals-route": {
        "ClusterId": "backoffice",
        "Match": { "Path": "/api/transfer-approvals/{**catch-all}" }
      },
      "backoffice-ai-route": {
        "ClusterId": "backoffice",
        "Match": { "Path": "/api/ai/{**catch-all}" }
      },
      "backoffice-v1-cash-closings-route": {
        "ClusterId": "backoffice",
        "Order": 1,
        "Match": { "Path": "/api/backoffice/cash-closings/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/backoffice/cash-closings" },
          { "PathPrefix": "/api/v1/cash-closings" }
        ]
      },
      "backoffice-v1-promotions-route": {
        "ClusterId": "backoffice",
        "Order": 1,
        "Match": { "Path": "/api/backoffice/promotions/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/backoffice/promotions" },
          { "PathPrefix": "/api/v1/promotions" }
        ]
      },
      "backoffice-v1-recipes-route": {
        "ClusterId": "backoffice",
        "Order": 1,
        "Match": { "Path": "/api/backoffice/recipes/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/backoffice/recipes" },
          { "PathPrefix": "/api/v1/recipes" }
        ]
      },
      "backoffice-v1-reservations-route": {
        "ClusterId": "backoffice",
        "Order": 1,
        "Match": { "Path": "/api/backoffice/reservations/{**catch-all}" },
        "Transforms": [

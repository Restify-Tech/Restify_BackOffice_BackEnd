      "signalr-delivery-route": {
        "ClusterId": "backoffice",
        "Match": { "Path": "/hubs/delivery-tracking/{**catch-all}" }
      },
      "sync-route": {
        "ClusterId": "sync",
        "Match": { "Path": "/api/sync/{**catch-all}" }
      },
      "payment-gateway-route": {
        "ClusterId": "payment-gateway",
        "Match": { "Path": "/api/gateway/{**catch-all}" }
      },
      "invoicing-route": {
        "ClusterId": "invoicing",
        "Match": { "Path": "/api/invoicing/{**catch-all}" }
      },
      "observability-route": {
        "ClusterId": "observability",
        "Match": { "Path": "/api/observability/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/observability" },
          { "PathPrefix": "/api" }
        ]
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5285" }
        }
      },
      "core": {
        "Destinations": {
          "d1": { "Address": "http://localhost:55966" }
        }
      },
      "backoffice": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5287" }
        }
      },
      "invoicing": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5300" }
        }
      },
      "payment-gateway": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5400" }
        }
      },
      "sync": {
        "Destinations": {
          "d1": { "Address": "http://localhost:8000" }
        }
      },
      "observability": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5950" }
        }
      }
    }
  }
}

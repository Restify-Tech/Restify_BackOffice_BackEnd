      "backoffice-v1-branches-route": {
        "ClusterId": "backoffice",
        "Order": 1,
        "Match": { "Path": "/api/backoffice/branches/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/backoffice/branches" },
          { "PathPrefix": "/api/v1/branches" }
        ]
      },
      "backoffice-v1-franchise-route": {
        "ClusterId": "backoffice",
        "Order": 1,
        "Match": { "Path": "/api/backoffice/franchise/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/backoffice/franchise" },
          { "PathPrefix": "/api/v1/franchise" }
        ]
      },
      "backoffice-v1-split-payments-route": {
        "ClusterId": "backoffice",
        "Order": 1,
        "Match": { "Path": "/api/backoffice/split-payments/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/backoffice/split-payments" },
          { "PathPrefix": "/api/v1/split-payments" }
        ]
      },
      "backoffice-v1-stock-alerts-route": {
        "ClusterId": "backoffice",
        "Order": 1,
        "Match": { "Path": "/api/backoffice/stock-alerts/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/backoffice/stock-alerts" },
          { "PathPrefix": "/api/v1/inventory" }
        ]
      },
      "backoffice-v1-webhooks-route": {
        "ClusterId": "backoffice",
        "Order": 1,
        "Match": { "Path": "/api/backoffice/webhooks/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/backoffice/webhooks" },
          { "PathPrefix": "/api/v1/webhooks" }
        ]
      },
      "backoffice-route": {
        "ClusterId": "backoffice",
        "Order": 99,
        "Match": { "Path": "/api/backoffice/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/backoffice" },
          { "PathPrefix": "/api" }
        ]
      },
      "signalr-orders-route": {
        "ClusterId": "backoffice",
        "Match": { "Path": "/hubs/orders/{**catch-all}" }
